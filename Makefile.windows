#
# Makefile for RAMSES using gfortran (Windows, MinGW-w64 via MSYS2)
# This is the free-toolchain Windows route. The Intel oneAPI route is
# unaffected and still uses Visual Studio with URAMSES.sln.
# For Linux use Makefile.linux; for macOS use Makefile.macos.
#
# Run this from an "MSYS2 MinGW 64-bit" shell, not the plain MSYS shell:
# the plain MSYS shell targets the Cygwin-like runtime and produces a DLL
# that Python cannot load.
#
# Author: Sustainable Power Systems Lab (SPS-L)
# Web: https://sps-lab.org
# Contact: info@sps-lab.org
# Last edited: August 2026
#

# ============================================================================
# Configuration
# ============================================================================

# Compiler and tools
# Assigned with = rather than ?= because make predefines FC as f77, which ?=
# would leave in place; a command-line FC= still wins over this.
FC = gfortran
AR = ar
RM = rm -f
RMDIR = rm -rf
MKDIR = mkdir -p

# Directories
SRC_DIR = src
MY_MODELS_DIR = my_models
MOD_DIR = modules_win_gfortran
OUT_DIR = Release_gnu_w
OBJ_DIR = $(OUT_DIR)/obj

# Output files
# PyRAMSES loads ramses.dll on Windows (ramses.so on Linux/macOS).
TARGET_DLL = ramses.dll
TARGET_EXE = dynsim.exe

# Compiler flags
# -O2: Optimization level 2
# -cpp: Enable C preprocessor
# -fopenmp: Enable OpenMP support
# -DDLL: Define DLL preprocessor macro (enables the DLLEXPORT attributes)
# -ffree-line-length-none: No line length limit for free-form Fortran
# -ffree-form: Use free-form source layout
# Note: -fPIC is deliberately absent. Windows PE code is position independent
# by construction and gfortran warns that the flag is ignored for this target.
FFLAGS = -O2 -cpp -fopenmp -DDLL \
         -ffree-line-length-none -ffree-form \
         -I$(MOD_DIR)

# Linker flags for shared library
LDFLAGS_DLL = -shared -fopenmp

# Linker flags for executable
LDFLAGS_EXE = -fopenmp

# Libraries
# The Windows gfortran kit ships the RAMSES archive as libramses.lib rather
# than libramses.a. MinGW's linker does not probe that name for -lramses, so
# the archive is passed by explicit path instead.
RAMSES_LIB = $(MOD_DIR)/libramses.lib

LIBS = $(RAMSES_LIB) -lopenblas

# ============================================================================
# Source files
# ============================================================================

# Source files from src/ (excluding main.f90 which is for executable only)
SRC_FILES = $(filter-out $(SRC_DIR)/main.f90, $(wildcard $(SRC_DIR)/*.f90))

# Source files from my_models/ (only .f90 files)
MY_MODEL_FILES = $(wildcard $(MY_MODELS_DIR)/*.f90)

# All source files for shared library
SRCS = $(SRC_FILES) $(MY_MODEL_FILES)

# Object files for shared library
OBJS = $(addprefix $(OBJ_DIR)/, $(notdir $(SRCS:.f90=.o)))

# Object files for executable (includes main.o)
OBJS_EXE = $(OBJS) $(OBJ_DIR)/main.o

# ============================================================================
# Check for Windows
# ============================================================================

# Detected platform. MSYS2 sets OS=Windows_NT; uname reports MINGW64_NT-* in a
# MinGW shell and MSYS_NT-* in the plain MSYS shell. UNAME_S is a plain
# variable so a dry run can be checked from another host, e.g.
# "make -f Makefile.windows UNAME_S=MINGW64_NT-10.0 -n".
UNAME_S := $(shell uname -s 2>/dev/null)

ifneq ($(OS),Windows_NT)
    ifeq (,$(findstring MINGW,$(UNAME_S)))
        $(error This Makefile is for Windows with MinGW-w64/MSYS2. For Linux use Makefile.linux; for macOS use Makefile.macos; for Intel oneAPI use Visual Studio with URAMSES.sln)
    endif
endif

# The plain MSYS shell links against the msys-2.0 runtime, producing a DLL that
# CPython cannot load. Require the MinGW 64-bit shell.
ifneq (,$(findstring MSYS_NT,$(UNAME_S)))
    $(error Run this from the "MSYS2 MinGW 64-bit" shell, not the plain MSYS shell)
endif

# ============================================================================
# Targets
# ============================================================================

.PHONY: all dll exe clean check-deps help

# Default target - build both shared library and executable
all: check-deps $(OUT_DIR)/$(TARGET_DLL) $(OUT_DIR)/$(TARGET_EXE)

# Build only shared library
dll: check-deps $(OUT_DIR)/$(TARGET_DLL)

# Build only executable
exe: check-deps $(OUT_DIR)/$(TARGET_EXE)

# Help target
help:
	@echo "RAMSES Windows Build System (gfortran / MinGW-w64)"
	@echo "=================================================="
	@echo ""
	@echo "Usage: make -f Makefile.windows [target]"
	@echo ""
	@echo "Targets:"
	@echo "  all         - Build both ramses.dll and dynsim.exe (default)"
	@echo "  dll         - Build only ramses.dll (shared library)"
	@echo "  exe         - Build only dynsim.exe (executable)"
	@echo "  clean       - Remove all build artifacts"
	@echo "  check-deps  - Verify required dependencies"
	@echo "  help        - Show this help message"
	@echo ""
	@echo "Output:"
	@echo "  $(OUT_DIR)/$(TARGET_DLL)   - Shared library for PyRAMSES"
	@echo "  $(OUT_DIR)/$(TARGET_EXE)  - Standalone executable"
	@echo ""
	@echo "Run from the MSYS2 MinGW 64-bit shell. For the Intel oneAPI route,"
	@echo "use Visual Studio with URAMSES.sln instead."

# Check dependencies
check-deps:
	@echo "Checking dependencies..."
	@echo ""
	@echo "Checking for gfortran..."
	@if ! command -v $(FC) > /dev/null 2>&1; then \
		echo "ERROR: $(FC) not found. Install it from an MSYS2 shell:"; \
		echo "  pacman -S mingw-w64-x86_64-gcc-fortran"; \
		exit 1; \
	else \
		echo "  Found: $$($(FC) --version | head -n1)"; \
	fi
	@echo ""
	@echo "Checking for OpenBLAS..."
	@if pkg-config --exists openblas > /dev/null 2>&1; then \
		echo "  Found: OpenBLAS $$(pkg-config --modversion openblas)"; \
	else \
		echo "ERROR: OpenBLAS not found. Install it from an MSYS2 shell:"; \
		echo "  pacman -S mingw-w64-x86_64-openblas"; \
		exit 1; \
	fi
	@echo ""
	@echo "Checking for pre-compiled modules..."
	@if [ ! -d "$(MOD_DIR)" ]; then \
		echo "ERROR: Module directory '$(MOD_DIR)' not found."; \
		exit 1; \
	fi
	@if [ ! -f "$(RAMSES_LIB)" ]; then \
		echo "ERROR: Pre-compiled library '$(RAMSES_LIB)' not found."; \
		exit 1; \
	fi
	@echo "  Found: $(RAMSES_LIB)"
	@MOD_COUNT=$$(ls -1 $(MOD_DIR)/*.mod 2>/dev/null | wc -l); \
	echo "  Found: $$MOD_COUNT module files in $(MOD_DIR)/"
	@echo ""
	@echo "Checking module kit and gfortran compatibility..."
	@bash tools/check_kit.sh $(MOD_DIR) $(FC) windows
	@echo ""
	@echo "All dependencies satisfied."
	@echo ""

# ============================================================================
# Build rules
# ============================================================================

# Create output directory
$(OUT_DIR):
	$(MKDIR) $(OUT_DIR)

# Create object directory
$(OBJ_DIR): | $(OUT_DIR)
	$(MKDIR) $(OBJ_DIR)

# Build shared library
$(OUT_DIR)/$(TARGET_DLL): $(OBJS) | $(OUT_DIR)
	@echo ""
	@echo "Linking $(TARGET_DLL)..."
	$(FC) $(LDFLAGS_DLL) -o $@ $(OBJS) $(LIBS)
	@echo ""
	@echo "Shared library built: $@"

# Build executable
$(OUT_DIR)/$(TARGET_EXE): $(OBJS_EXE) | $(OUT_DIR)
	@echo ""
	@echo "Linking $(TARGET_EXE)..."
	$(FC) $(LDFLAGS_EXE) -o $@ $(OBJS_EXE) $(LIBS)
	@echo ""
	@echo "Executable built: $@"

# Compile source files from src/
$(OBJ_DIR)/%.o: $(SRC_DIR)/%.f90 | $(OBJ_DIR)
	@echo "Compiling $<..."
	$(FC) $(FFLAGS) -c $< -o $@ -J$(OBJ_DIR)

# Compile source files from my_models/
$(OBJ_DIR)/%.o: $(MY_MODELS_DIR)/%.f90 | $(OBJ_DIR)
	@echo "Compiling $<..."
	$(FC) $(FFLAGS) -c $< -o $@ -J$(OBJ_DIR)

# ============================================================================
# Clean
# ============================================================================

clean:
	@echo "Cleaning build artifacts..."
	$(RMDIR) $(OUT_DIR)
	@echo "Clean complete."

# ============================================================================
# File dependencies
# ============================================================================

# FUNCTIONS_IN_MODELS must be compiled before model files that use it
$(OBJ_DIR)/exc_ENTSOE_lim.o: $(OBJ_DIR)/FUNCTIONS_IN_MODELS.o
$(OBJ_DIR)/inj_AIR_COND1_mod.o: $(OBJ_DIR)/FUNCTIONS_IN_MODELS.o

# usr_*_models files depend on their respective model files
$(OBJ_DIR)/usr_exc_models.o: $(OBJ_DIR)/exc_ENTSOE_lim.o
$(OBJ_DIR)/usr_inj_models.o: $(OBJ_DIR)/inj_AIR_COND1_mod.o

# c_interface depends on usr_*_models
$(OBJ_DIR)/c_interface.o: $(OBJ_DIR)/usr_exc_models.o $(OBJ_DIR)/usr_inj_models.o $(OBJ_DIR)/usr_tor_models.o $(OBJ_DIR)/usr_twop_models.o $(OBJ_DIR)/usr_dctl_models.o

# main.o depends on c_interface (for executable)
$(OBJ_DIR)/main.o: $(OBJ_DIR)/c_interface.o
